# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# credentials, and never point local development at a database holding real
# patient contact details.
DATABASE_URL=postgres://snoon:snoon_dev@127.0.0.1:5432/snoon_dev

# Signs the patient tracking links. Long and random; rotating it invalidates
# every outstanding tracking link, so treat rotation as a deliberate act.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_TOKEN_SECRET=replace-me-with-a-long-random-value

# Signs Better Auth sessions. Long and random; rotating it logs everyone out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-value
# The site's own public URL. Verification links are built from this.
BETTER_AUTH_URL=http://localhost:3000

# Signs Payload admin sessions. Long and random; rotating it logs admins out.
PAYLOAD_SECRET=replace-me-with-a-long-random-value

# Telegram notifications. Optional: without these, notifications are simply off
# and the opt-in sections do not appear. Create a bot with @BotFather, then set
# the webhook to https://<your-site>/api/telegram/webhook with the same secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Authorises the scheduled-job endpoint at /api/cron, which releases expired
# claims and expires stale cases. Without it the route refuses to run.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Email, through Resend. Without both of these, production refuses student
# sign-up rather than creating accounts nobody can verify; development prints
# messages to the console instead.
#
# Resend delivers to arbitrary addresses only once a sending domain is verified
# in their dashboard — until then it accepts mail only to the account owner's
# own address. EMAIL_FROM must be on that verified domain.
RESEND_API_KEY=
EMAIL_FROM=سنون <no-reply@example.com>
