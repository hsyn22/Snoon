# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# credentials, and never point local development at a database holding real
# patient contact details.
DATABASE_URL=postgres://snoon:snoon_dev@127.0.0.1:5432/snoon_dev

# Signs the patient tracking links. Long and random; rotating it invalidates
# every outstanding tracking link, so treat rotation as a deliberate act.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_TOKEN_SECRET=replace-me-with-a-long-random-value
