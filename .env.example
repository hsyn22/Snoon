# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# credentials, and never point local development at a database holding real
# patient contact details.
DATABASE_URL=postgres://snoon:snoon_dev@127.0.0.1:5432/snoon_dev

# Signs the patient tracking links. Long and random; rotating it invalidates
# every outstanding tracking link, so treat rotation as a deliberate act.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_TOKEN_SECRET=replace-me-with-a-long-random-value

# Signs Better Auth sessions. Long and random; rotating it logs everyone out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-value
# The site's own public URL. Verification links are built from this.
BETTER_AUTH_URL=http://localhost:3000

# Signs Payload admin sessions. Long and random; rotating it logs admins out.
PAYLOAD_SECRET=replace-me-with-a-long-random-value

# Telegram notifications. Optional: without these, notifications are simply off
# and the opt-in sections do not appear. Create a bot with @BotFather, then set
# the webhook to https://<your-site>/api/telegram/webhook with the same secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Authorises the scheduled-job endpoint at /api/cron, which releases expired
# claims and expires stale cases. Without it the route refuses to run.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Email, through Resend. Without both of these, production refuses student
# sign-up rather than creating accounts nobody can verify; development prints
# messages to the console instead.
#
# Resend delivers to arbitrary addresses only once a sending domain is verified
# in their dashboard — until then it accepts mail only to the account owner's
# own address. EMAIL_FROM must be on that verified domain.
RESEND_API_KEY=
EMAIL_FROM=سنون <no-reply@example.com>

# "Continue with Google" for students. Optional: without both of these the
# button simply does not appear.
#
# This is the one thing that opens student registration without a domain —
# Google has already verified the address, so no verification email is sent and
# nothing waits on Resend. It does NOT replace document verification: a student
# who signs in with Google still sees no case until an admin approves them.
#
# Set up at https://console.cloud.google.com — APIs & Services → Credentials →
# Create credentials → OAuth client ID → Web application. The consent screen
# only needs the default profile and email scopes.
#
# THE REDIRECT URI IS BUILT FROM BETTER_AUTH_URL ABOVE, not from the host the
# request arrived on. Whatever BETTER_AUTH_URL says, plus
# /api/auth/callback/google, is what must be registered in Google Cloud —
# scheme, host AND port, exactly. A mismatch is refused by Google with
# `redirect_uri_mismatch` before the student ever reaches سنون, and the site
# logs nothing, so there is no clue on our side at all. With BETTER_AUTH_URL
# set to http://localhost:3101, register:
#   http://localhost:3101/api/auth/callback/google
# and for production, the same thing built from the deployed URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage for uploaded files, through Cloudflare R2.
#
# WITHOUT THESE, UPLOADS GO TO THE LOCAL DISK. That is correct in development
# and silently destructive on Vercel, whose filesystem is destroyed minutes
# after a deploy: a patient's intraoral photograph and a student's enrolment
# document both appear to save and are gone before anyone looks at them. Nothing
# errors — the row keeps a filename pointing at a file that no longer exists.
#
# R2 rather than anything else for three reasons: ten gigabytes free, no charge
# for serving, and a bucket that is private by default. The third matters most —
# the access table in CLAUDE.md rests on there being no URL that serves an
# intraoral photograph without passing a check.
#
# Set up at dash.cloudflare.com → Storage & Databases → R2 Object Storage:
#   1. Create a bucket. Its name is R2_BUCKET.
#   2. The account id is in the R2 sidebar, and in the S3 API endpoint
#      https://<account-id>.r2.cloudflarestorage.com
#   3. Manage R2 API Tokens → Create API token → Object Read & Write, scoped to
#      that one bucket. The Access Key ID and Secret Access Key are shown once.
#
# All four are required together: three of four is a deployment that believes it
# has object storage and does not, so سنون treats it as none at all.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
